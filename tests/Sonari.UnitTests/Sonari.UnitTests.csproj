<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas que no necesitan hardware de audio. xUnit v3: el proyecto de pruebas es un ejecutable. -->
  <PropertyGroup>
    <TargetFramework>$(SonariNet)-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Sonari.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sonari.Audio.Core\Sonari.Audio.Core.csproj" />
    <ProjectReference Include="..\..\src\Sonari.Audio.Devices\Sonari.Audio.Devices.csproj" />
    <ProjectReference Include="..\..\src\Sonari.Audio.Engine\Sonari.Audio.Engine.csproj" />
    <ProjectReference Include="..\..\src\Sonari.Infrastructure\Sonari.Infrastructure.csproj" />
  </ItemGroup>

</Project>
