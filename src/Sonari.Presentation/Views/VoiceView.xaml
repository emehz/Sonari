<UserControl x:Class="Sonari.Presentation.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sonari.Presentation.ViewModels"
             xmlns:effects="clr-namespace:Sonari.Audio.Core.Effects;assembly=Sonari.Audio.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VoiceViewModel}"
             d:DesignWidth="940" d:DesignHeight="720">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Un parámetro: etiqueta, valor y deslizador -->
    <DataTemplate x:Key="ParameterTemplate" DataType="{x:Type vm:EffectParameterViewModel}">
      <StackPanel Margin="0,10,0,0" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <DockPanel Margin="0,0,0,4">
          <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Style="{StaticResource Text.Caption}" />
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
        </DockPanel>
        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding Label}" />
      </StackPanel>
    </DataTemplate>

    <!-- Tarjeta de un efecto -->
    <DataTemplate x:Key="EffectCard" DataType="{x:Type vm:EffectViewModel}">
      <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource Button.Ghost}" Padding="6" IsEnabled="{Binding CanMoveUp}"
                      Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" ToolTip="Antes en la cadena" AutomationProperties.Name="Mover antes">
                <TextBlock Text="&#xE70E;" Style="{StaticResource Text.Icon}" FontSize="11" />
              </Button>
              <Button Style="{StaticResource Button.Ghost}" Padding="6" Margin="2,0,0,0" IsEnabled="{Binding CanMoveDown}"
                      Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" ToolTip="Después en la cadena" AutomationProperties.Name="Mover después">
                <TextBlock Text="&#xE70D;" Style="{StaticResource Text.Icon}" FontSize="11" />
              </Button>
            </StackPanel>
            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" Content="{Binding Title}"
                          AutomationProperties.Name="{Binding Title}" />
          </DockPanel>

          <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                     TextWrapping="Wrap" TextTrimming="None" />

          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Margin="0,12,0,0"
                    Visibility="{Binding HasModes, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Tipo de modulación" />

          <ItemsControl ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource ParameterTemplate}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,16,24">

      <!-- Cabecera con el interruptor general -->
      <DockPanel Margin="0,0,16,0">
        <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Switch}"
                      IsChecked="{Binding IsEnabled}" Content="Efectos activados"
                      ToolTip="Apagado, tu voz pasa sin efectos (se conserva la configuración)" />
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <!-- Voces predefinidas -->
      <Border Style="{StaticResource Card}" Margin="0,20,16,0">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}">
              <Run Text="Voz actual:" />
              <Run Text="{Binding CurrentVoiceName, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
            </TextBlock>
            <TextBlock Text="Voces" Style="{StaticResource Text.Section}" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Presets}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type effects:VoicePreset}">
                <Button Content="{Binding Name}" ToolTip="{Binding Description}" Margin="0,6,8,0" MinWidth="96"
                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding MonitorHint}" Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                     TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
      </Border>

      <!-- Cadena -->
      <DockPanel Margin="0,24,16,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding RestoreOrderCommand}"
                Content="Restablecer orden" ToolTip="Vuelve al orden recomendado de la cadena" />
        <StackPanel>
          <TextBlock Text="Cadena de efectos" Style="{StaticResource Text.Section}" />
          <TextBlock Text="La voz pasa por los efectos activados de izquierda a derecha y de arriba abajo."
                     Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>

      <ItemsControl ItemsSource="{Binding Effects}" ItemTemplate="{StaticResource EffectCard}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
