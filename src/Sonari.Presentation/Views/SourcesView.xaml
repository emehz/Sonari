<UserControl x:Class="Sonari.Presentation.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sonari.Presentation.ViewModels"
             xmlns:controls="clr-namespace:Sonari.Presentation.Controls"
             xmlns:conv="clr-namespace:Sonari.Presentation.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SourcesViewModel}"
             d:DesignWidth="940" d:DesignHeight="760">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Icono del ejecutable o, si no hay, un glifo genérico -->
    <DataTemplate x:Key="AppIcon">
      <Grid Width="32" Height="32">
        <Image Source="{Binding Icon}" Width="28" Height="28"
               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="&#xE71D;" Style="{StaticResource Text.Icon}" HorizontalAlignment="Center"
                   Visibility="{Binding HasIcon, Converter={x:Static conv:VisibilityConverters.False}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,24">

      <!-- Cabecera -->
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Actualizar" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" />
        </StackPanel>
      </DockPanel>

      <!-- Avisos -->
      <Border Style="{StaticResource Card.Warning}" Margin="0,16,0,0"
              Visibility="{Binding SupportsCapture, Converter={x:Static conv:VisibilityConverters.False}}">
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Warning}"
                   Text="Esta versión de Windows no permite capturar aplicaciones. Se necesita Windows 10 versión 2004 (build 19041) o posterior." />
      </Border>
      <Border Style="{StaticResource Card.Warning}" Margin="0,16,0,0"
              Visibility="{Binding HasDuplicationRisk, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Warning}"
                   Text="«Audio del sistema» ya incluye las aplicaciones que capturas por separado: sonarán dos veces. Silencia una de las dos en el Mezclador o quita la que sobre." />
      </Border>
      <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.Danger}" Margin="0,16,0,0"
              Visibility="{Binding ErrorMessage, Converter={x:Static conv:VisibilityConverters.NotNull}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Danger}" />
      </Border>

      <!-- En el mezclador -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="En el mezclador" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding AddedSources}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
                <DockPanel Margin="0,4">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Quitar"
                          Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                          Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
                  <Grid Width="32" Height="32">
                    <Image Source="{Binding Icon}" Width="24" Height="24"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" HorizontalAlignment="Center"
                               Visibility="{Binding HasIcon, Converter={x:Static conv:VisibilityConverters.False}}" />
                  </Grid>
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Brush.Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <Ellipse Style="{StaticResource StatusDot.Source}" />
                      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Audio del sistema -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Añadir"
                  Command="{Binding AddSystemAudioCommand}" IsEnabled="{Binding CanAddSystemAudio}" />
          <TextBlock DockPanel.Dock="Left" Text="&#xE7F5;" Style="{StaticResource Text.Icon}" Width="32" TextAlignment="Center" />
          <StackPanel Margin="10,0,16,0">
            <TextBlock Text="Audio del sistema" Foreground="{StaticResource Brush.Text}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,2,0,0"
                       Text="Todo lo que suena en Windows excepto Sonari, así tu monitoreo y tus efectos no vuelven a entrar. Si además capturas una aplicación por separado, sonará dos veces." />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Aplicaciones -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowAllApplications}"
                          Content="Mostrar también aplicaciones sin audio" />
            <TextBlock Text="Aplicaciones" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
          </DockPanel>

          <ProgressBar IsIndeterminate="True" Margin="0,0,0,8"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

          <TextBlock Style="{StaticResource Text.Body}" TextTrimming="None"
                     Visibility="{Binding Applications.Count, Converter={x:Static conv:VisibilityConverters.Zero}}"
                     Text="No hay aplicaciones con audio abierto. Reproduce algo o activa «Mostrar también aplicaciones sin audio»." />

          <ItemsControl ItemsSource="{Binding Applications}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ApplicationItemViewModel}">
                <Border Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" ToolTip="Está reproduciendo audio ahora">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Brush.Border}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <controls:LevelMeter LevelDb="{Binding LevelDb}" PeakDb="-96" Width="90" Height="6" Margin="8,0,16,0" />
                      <Button Content="{Binding AddButtonText}" MinWidth="90" IsEnabled="{Binding CanAdd}"
                              ToolTip="{Binding AddDisabledReason}" ToolTipService.ShowOnDisabled="True"
                              Command="{Binding DataContext.AddApplicationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>

                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" />

                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0"
                                 Visibility="{Binding WindowTitle, Converter={x:Static conv:VisibilityConverters.NotNull}}" />
                      <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Warning}" Margin="0,3,0,0"
                                 TextWrapping="Wrap" TextTrimming="None"
                                 Visibility="{Binding IsCallApplication, Converter={StaticResource BoolToVisibility}}"
                                 Text="Aplicación de llamadas: si la envías al micrófono virtual, los demás se oirán a sí mismos." />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
