<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Sonari.Presentation.ViewModels"
                    xmlns:views="clr-namespace:Sonari.Presentation.Views">

  <!-- Navegación ViewModel-first: el ContentControl de la ventana elige la vista según el tipo de ViewModel. -->
  <DataTemplate DataType="{x:Type vm:PlannedPageViewModel}">
    <views:PlannedPageView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:MixerViewModel}">
    <views:MixerView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
    <views:DevicesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <views:SettingsView />
  </DataTemplate>

</ResourceDictionary>
