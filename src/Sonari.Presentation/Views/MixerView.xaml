<UserControl x:Class="Sonari.Presentation.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sonari.Presentation.ViewModels"
             xmlns:controls="clr-namespace:Sonari.Presentation.Controls"
             xmlns:conv="clr-namespace:Sonari.Presentation.Converters"
             xmlns:engine="clr-namespace:Sonari.Audio.Core.Engine;assembly=Sonari.Audio.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MixerViewModel}"
             d:DesignWidth="940" d:DesignHeight="720">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <!-- Tira de canal: una por fuente -->
    <DataTemplate x:Key="ChannelStrip" DataType="{x:Type vm:ChannelViewModel}">
      <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <ToggleButton Style="{StaticResource Toggle.Mute}" IsChecked="{Binding IsMuted}"
                            ToolTip="Silenciar este canal" AutomationProperties.Name="Silenciar canal">
                <TextBlock Text="&#xE74F;" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
              </ToggleButton>
              <Button Style="{StaticResource Button.Ghost}" Margin="4,0,0,0" Padding="8"
                      Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                      Command="{Binding DataContext.RemoveChannelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" ToolTip="Quitar del mezclador" AutomationProperties.Name="Quitar fuente">
                <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" FontSize="12" />
              </Button>
            </StackPanel>

            <Grid Width="28" Height="28" VerticalAlignment="Top">
              <Image Source="{Binding Icon}" Width="24" Height="24"
                     Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" HorizontalAlignment="Center"
                         Visibility="{Binding HasIcon, Converter={x:Static conv:VisibilityConverters.False}}" />
            </Grid>

            <StackPanel Margin="10,0,8,0">
              <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Section}" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding DisplayName}" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Ellipse Style="{StaticResource StatusDot.Source}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                           MaxWidth="170" ToolTip="{Binding StatusMessage}" />
              </StackPanel>
            </StackPanel>
          </DockPanel>

          <controls:LevelMeter LevelDb="{Binding LevelDb}" PeakDb="{Binding PeakDb}" Height="8" Margin="0,16,0,0" />

          <DockPanel Margin="0,14,0,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding GainText}" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="Ganancia" Style="{StaticResource Text.Caption}" />
          </DockPanel>
          <Slider Minimum="-60" Maximum="12" Value="{Binding GainDb}" SmallChange="0.5" LargeChange="3"
                  AutomationProperties.Name="Ganancia del canal" />

          <DockPanel Margin="0,10,0,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceText}" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="Balance" Style="{StaticResource Text.Caption}" />
          </DockPanel>
          <Slider Minimum="-1" Maximum="1" Value="{Binding Balance}" SmallChange="0.05" LargeChange="0.25"
                  ToolTip="Doble clic para centrar" MouseDoubleClick="OnBalanceDoubleClick"
                  AutomationProperties.Name="Balance del canal" />

          <ToggleButton Style="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding SendToVirtual}"
                        Content="Enviar al micrófono virtual" ToolTip="Lo oirán los demás (Discord, juegos…)" />
          <ToggleButton Style="{StaticResource Switch}" Margin="0,10,0,0" IsChecked="{Binding SendToMonitor}"
                        Content="Enviar al monitoreo" ToolTip="{Binding MonitorHint}" />
          <TextBlock Text="{Binding MonitorHint}" Style="{StaticResource Text.Caption}" Margin="46,4,0,0"
                     TextWrapping="Wrap" TextTrimming="None" />

          <TextBlock Text="{Binding Diagnostics}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                     TextWrapping="Wrap" TextTrimming="None" FontFamily="Consolas, Segoe UI"
                     Visibility="{Binding Diagnostics, Converter={x:Static conv:VisibilityConverters.NotNull}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,16,24">

      <!-- Cabecera con el interruptor del motor -->
      <DockPanel Margin="0,0,16,0">
        <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Height="34"
                      IsChecked="{Binding IsGlobalMuted}" ToolTip="Corta todo lo que sale de Sonari"
                      AutomationProperties.Name="Silencio global">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Mute}">
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Padding" Value="12,0" />
            </Style>
          </ToggleButton.Style>
          <StackPanel Orientation="Horizontal" Margin="12,0">
            <TextBlock Text="&#xE74F;" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <TextBlock Text="Silencio global" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </StackPanel>
        </ToggleButton>
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" MinWidth="140"
                Style="{StaticResource Button.Accent}"
                Command="{Binding ToggleEngineCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE768;" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                      <Setter Property="Text" Value="&#xE71A;" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding EngineButtonText}" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" />
        </StackPanel>
      </DockPanel>

      <!-- Estado -->
      <Border Style="{StaticResource Card}" Margin="0,20,16,0" Padding="14,10">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="10" Height="10" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding EngineState}" Value="{x:Static engine:EngineState.Running}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding EngineState}" Value="{x:Static engine:EngineState.Starting}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Info}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding EngineState}" Value="{x:Static engine:EngineState.Recovering}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <StackPanel Margin="12,0,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                       Visibility="{Binding DeviceSummary, Converter={x:Static conv:VisibilityConverters.NotNull}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Dispositivos -->
      <Border Style="{StaticResource Card}" Margin="0,16,16,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Micrófono" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}"
                      AutomationProperties.Name="Micrófono" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Monitoreo (auriculares)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding MonitorDevices}" SelectedItem="{Binding SelectedMonitor}"
                      AutomationProperties.Name="Dispositivo de monitoreo" />
          </StackPanel>
          <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                  Command="{Binding RefreshDevicesCommand}" ToolTip="Volver a leer los dispositivos">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="14" />
          </Button>

          <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,14,0,0">
            <TextBlock Text="Micrófono virtual (salida al cable)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding VirtualDevices}" SelectedItem="{Binding SelectedVirtual}"
                      AutomationProperties.Name="Salida del micrófono virtual" />
            <TextBlock Text="{Binding DiscordHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                       Foreground="{StaticResource Brush.AccentHover}" TextWrapping="Wrap" TextTrimming="None"
                       Visibility="{Binding DiscordHint, Converter={x:Static conv:VisibilityConverters.NotNull}}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Avisos de enrutado -->
      <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.Danger}" Background="#3A1C22" Margin="0,16,16,0" Padding="14,10"
              Visibility="{Binding RoutingError, Converter={x:Static conv:VisibilityConverters.NotNull}}">
        <TextBlock Text="{Binding RoutingError}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Danger}" />
      </Border>
      <Border Style="{StaticResource Card.Warning}" Margin="0,16,16,0"
              Visibility="{Binding RoutingWarning, Converter={x:Static conv:VisibilityConverters.NotNull}}">
        <TextBlock Text="{Binding RoutingWarning}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Warning}" />
      </Border>

      <!-- Aviso de silencio global -->
      <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.Danger}" Background="#3A1C22" Margin="0,16,16,0" Padding="14,10"
              Visibility="{Binding IsGlobalMuted, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Danger}"
                   Text="Silencio global activado: no sale nada de Sonari. Las fuentes siguen capturando y vuelven al instante al quitarlo." />
      </Border>

      <!-- Aviso de duplicación -->
      <Border Style="{StaticResource Card.Warning}" Margin="0,16,16,0"
              Visibility="{Binding HasDuplicationRisk, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Warning}"
                   Text="«Audio del sistema» ya incluye las aplicaciones que capturas por separado: sonarán dos veces. Silencia una de las dos o quita la que sobre." />
      </Border>

      <!-- Canales -->
      <TextBlock Text="Canales" Style="{StaticResource Text.Section}" Margin="0,24,0,12" />
      <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelStrip}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,-6,0,0" TextTrimming="None"
                 Text="Añade aplicaciones o el audio del sistema desde la sección Fuentes." />

      <!-- Bus de monitoreo y diagnóstico -->
      <Grid Margin="0,24,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Toggle.Mute}"
                            IsChecked="{Binding VirtualMuted}" ToolTip="Silenciar el micrófono virtual"
                            AutomationProperties.Name="Silenciar micrófono virtual">
                <TextBlock Text="&#xE74F;" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
              </ToggleButton>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE720;" Style="{StaticResource Text.Icon}" />
                <TextBlock Text="Micrófono virtual" Style="{StaticResource Text.Section}" Margin="10,0,0,0" />
              </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsVirtualActive}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding VirtualStatusText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                         MaxWidth="240" ToolTip="{Binding VirtualStatusText}" />
            </StackPanel>

            <controls:LevelMeter LevelDb="{Binding VirtualLevelDb}" PeakDb="{Binding VirtualPeakDb}" Height="8" Margin="0,14,0,0" />

            <DockPanel Margin="0,14,0,4">
              <TextBlock DockPanel.Dock="Right" Text="{Binding VirtualGainText}" Style="{StaticResource Text.Caption}" />
              <TextBlock Text="Volumen" Style="{StaticResource Text.Caption}" />
            </DockPanel>
            <Slider Minimum="{Binding MinGainDb}" Maximum="{Binding MaxGainDb}" Value="{Binding VirtualGainDb}"
                    SmallChange="0.5" LargeChange="3" AutomationProperties.Name="Volumen del micrófono virtual" />

            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0" TextWrapping="Wrap" TextTrimming="None">
              <Run Text="Lo que oyen los demás. Limitador: " /><Run Text="{Binding VirtualLimiterText, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="0" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Toggle.Mute}"
                            IsChecked="{Binding MonitorMuted}" ToolTip="Silenciar monitoreo"
                            AutomationProperties.Name="Silenciar monitoreo">
                <TextBlock Text="&#xE74F;" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
              </ToggleButton>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7F6;" Style="{StaticResource Text.Icon}" />
                <TextBlock Text="Monitoreo" Style="{StaticResource Text.Section}" Margin="10,0,0,0" />
              </StackPanel>
            </DockPanel>

            <controls:LevelMeter LevelDb="{Binding MonitorLevelDb}" PeakDb="{Binding MonitorPeakDb}" Height="8" Margin="0,16,0,0" />

            <DockPanel Margin="0,14,0,4">
              <TextBlock DockPanel.Dock="Right" Text="{Binding MonitorGainText}" Style="{StaticResource Text.Caption}" />
              <TextBlock Text="Volumen" Style="{StaticResource Text.Caption}" />
            </DockPanel>
            <Slider Minimum="{Binding MinGainDb}" Maximum="{Binding MaxGainDb}" Value="{Binding MonitorGainDb}"
                    SmallChange="0.5" LargeChange="3" AutomationProperties.Name="Volumen de monitoreo" />

            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Text="Lo que oyes aquí nunca se envía al micrófono virtual." />
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Diagnóstico del motor" Style="{StaticResource Text.Section}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,14"
                       Text="Cada canal muestra su buffer, su deriva y sus vaciados. «Pausas» en una aplicación significa que dejó de sonar, no es un error. El limitador evita que la mezcla supere −0,3 dBFS." />
            <UniformGrid Columns="1">
              <StackPanel>
                <TextBlock Text="Limitador del monitoreo" Style="{StaticResource StatLabel}" />
                <TextBlock Text="{Binding LimiterText}" Style="{StaticResource StatValue}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Resincronizaciones" Style="{StaticResource StatLabel}" />
                <TextBlock Text="{Binding Resyncs}" Style="{StaticResource StatValue}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Muestras recortadas" Style="{StaticResource StatLabel}" />
                <TextBlock Text="{Binding ClippedSamples}" Style="{StaticResource StatValue}" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
