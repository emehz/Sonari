<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Paleta. Cambiar un color aquí lo cambia en toda la aplicación. -->
  <Color x:Key="Color.Background">#0E1014</Color>
  <Color x:Key="Color.Sidebar">#12151B</Color>
  <Color x:Key="Color.Surface">#171B22</Color>
  <Color x:Key="Color.SurfaceRaised">#1D222B</Color>
  <Color x:Key="Color.Hover">#262C38</Color>
  <Color x:Key="Color.Border">#2A303C</Color>
  <Color x:Key="Color.Text">#E7E9EE</Color>
  <Color x:Key="Color.TextSecondary">#9AA3B5</Color>
  <Color x:Key="Color.TextMuted">#6B7385</Color>
  <Color x:Key="Color.Accent">#8B5CF6</Color>
  <Color x:Key="Color.AccentHover">#9D74F8</Color>
  <Color x:Key="Color.AccentPressed">#7646E8</Color>
  <Color x:Key="Color.AccentSoft">#2A2340</Color>
  <Color x:Key="Color.Success">#34D399</Color>
  <Color x:Key="Color.Warning">#FBBF24</Color>
  <Color x:Key="Color.Danger">#F87171</Color>
  <Color x:Key="Color.Info">#60A5FA</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

  <!-- Segoe Fluent Icons existe en Windows 11; Segoe MDL2 Assets es la alternativa en Windows 10. -->
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>

</ResourceDictionary>
