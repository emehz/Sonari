<UserControl x:Class="OndaMix.Presentation.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OndaMix.Presentation.ViewModels"
             xmlns:devices="clr-namespace:OndaMix.Audio.Core.Devices;assembly=OndaMix.Audio.Core"
             xmlns:conv="clr-namespace:OndaMix.Presentation.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DevicesViewModel}"
             d:DesignWidth="900" d:DesignHeight="700">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <DataTemplate x:Key="EndpointTemplate" DataType="{x:Type devices:AudioEndpointInfo}">
      <Border Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Brush.Text}"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}" />
          <WrapPanel Margin="0,6,0,0">
            <Border Style="{StaticResource Badge}"
                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Predeterminado" Style="{StaticResource Badge.Text}" />
            </Border>
            <Border Style="{StaticResource Badge}"
                    Visibility="{Binding IsDefaultCommunications, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Comunicaciones" Style="{StaticResource Badge.Text}" />
            </Border>
            <Border Style="{StaticResource Badge}" Background="#2B2614"
                    Visibility="{Binding IsLikelyVirtual, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Reconocido por su nombre como cable o micrófono virtual de terceros">
              <TextBlock Text="Posible dispositivo virtual" Style="{StaticResource Badge.Text}"
                         Foreground="{StaticResource Brush.Warning}" />
            </Border>
          </WrapPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <Style x:Key="EmptyListText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
      <Setter Property="Text" Value="No se encontró ningún dispositivo activo." />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Cabecera -->
    <DockPanel Grid.Row="0">
      <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.Text}" />
          <TextBlock Text="Actualizar" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" />
      </StackPanel>
    </DockPanel>

    <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,12,0,0"
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

    <!-- Avisos y compatibilidad -->
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.Danger}" Margin="0,0,0,12"
              Visibility="{Binding ErrorMessage, Converter={x:Static conv:VisibilityConverters.NotNull}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Danger}" />
      </Border>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,14,0">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Capabilities.ProcessLoopback}" Value="{x:Static devices:FeatureSupport.Supported}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Capabilities.ProcessLoopback}" Value="{x:Static devices:FeatureSupport.Probable}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Capabilities.ProcessLoopback}" Value="{x:Static devices:FeatureSupport.Unavailable}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Captura de audio por aplicación" Style="{StaticResource Text.Section}" />
            <TextBlock Text="{Binding Capabilities.ProcessLoopbackDetail}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
            <TextBlock Text="Micrófono virtual" Style="{StaticResource Text.Section}" Margin="0,14,0,0" />
            <TextBlock Text="{Binding VirtualDeviceSummary}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Listas de endpoints -->
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#xE720;" Style="{StaticResource Text.Icon}" />
            <TextBlock Text="Entradas" Style="{StaticResource Text.Section}" Margin="10,0,0,0" />
            <TextBlock Text="{Binding Inputs.Count}" Style="{StaticResource Text.Caption}" Margin="8,2,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Grid>
            <TextBlock Style="{StaticResource EmptyListText}"
                       Visibility="{Binding Inputs.Count, Converter={x:Static conv:VisibilityConverters.Zero}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource EndpointTemplate}" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#xE7F5;" Style="{StaticResource Text.Icon}" />
            <TextBlock Text="Salidas" Style="{StaticResource Text.Section}" Margin="10,0,0,0" />
            <TextBlock Text="{Binding Outputs.Count}" Style="{StaticResource Text.Caption}" Margin="8,2,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Grid>
            <TextBlock Style="{StaticResource EmptyListText}"
                       Visibility="{Binding Outputs.Count, Converter={x:Static conv:VisibilityConverters.Zero}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource EndpointTemplate}" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
