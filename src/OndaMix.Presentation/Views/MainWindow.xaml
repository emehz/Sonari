<Window x:Class="OndaMix.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OndaMix.Presentation.ViewModels"
        xmlns:engine="clr-namespace:OndaMix.Audio.Core.Engine;assembly=OndaMix.Audio.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="OndaMix"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PageTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Barra lateral ===== -->
    <Border Grid.Row="0" Grid.Column="0"
            Background="{StaticResource Brush.Sidebar}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,22">
          <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Brush.Accent}">
            <TextBlock Text="&#xE8D6;" Style="{StaticResource Text.Icon}" Foreground="White"
                       HorizontalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="OndaMix" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Text.Caption}">
              <Run Text="v" /><Run Text="{Binding AppVersion, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>

        <ListBox Style="{StaticResource NavList}"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 AutomationProperties.Name="Navegación principal">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PageViewModel}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===== Página activa ===== -->
    <ContentControl Grid.Row="0" Grid.Column="1"
                    Content="{Binding SelectedPage}"
                    Focusable="False" />

    <!-- ===== Barra de estado ===== -->
    <Border Grid.Row="1" Grid.ColumnSpan="2"
            Background="{StaticResource Brush.Sidebar}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="16,4">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding EngineState}" Value="{x:Static engine:EngineState.Running}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding EngineState}" Value="{x:Static engine:EngineState.Starting}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Info}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding EngineState}" Value="{x:Static engine:EngineState.Recovering}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding EngineStatusText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
          <TextBlock Text="·" Style="{StaticResource Text.Caption}" Margin="10,0" />
          <TextBlock Text="{Binding AudioFormatSummary}" Style="{StaticResource Text.Caption}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding WindowsVersion}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
          <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0"
                  Command="{Binding OpenLogFolderCommand}"
                  ToolTip="Abrir la carpeta de registros de diagnóstico">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE838;" Style="{StaticResource Text.Icon}" FontSize="12" />
              <TextBlock Text="Registros" FontSize="11" Margin="6,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
