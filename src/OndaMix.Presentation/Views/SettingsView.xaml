<UserControl x:Class="OndaMix.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OndaMix.Presentation.ViewModels"
             xmlns:conv="clr-namespace:OndaMix.Presentation.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="900" d:DesignHeight="700">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,24" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" />

      <!-- Audio -->
      <Border Style="{StaticResource Card}" Margin="0,24,0,0">
        <StackPanel>
          <TextBlock Text="Formato del motor" Style="{StaticResource Text.Section}" />
          <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,16"
                     Text="Se aplica la próxima vez que se inicie el motor. 48 kHz y 10 ms son un buen punto de partida; con 5 ms baja la latencia a cambio de más riesgo de cortes." />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="Frecuencia de muestreo" Foreground="{StaticResource Brush.Text}" />
              <TextBlock Text="Interna del mezclador" Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="200"
                      ItemsSource="{Binding SampleRates}"
                      SelectedItem="{Binding SampleRate}"
                      ItemStringFormat="{}{0} Hz"
                      AutomationProperties.Name="Frecuencia de muestreo" />

            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="Tamaño de bloque" Foreground="{StaticResource Brush.Text}" />
              <TextBlock Text="Menor = menos latencia, más CPU" Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="200"
                      ItemsSource="{Binding BufferSizes}"
                      SelectedItem="{Binding BufferMilliseconds}"
                      ItemStringFormat="{}{0} ms"
                      AutomationProperties.Name="Tamaño de bloque" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Guardar" Style="{StaticResource Button.Accent}" Command="{Binding SaveCommand}" />
            <Button Content="Descartar cambios" Margin="8,0,0,0" Command="{Binding DiscardChangesCommand}" />
            <Button Content="Valores por defecto" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}"
                    Command="{Binding RestoreDefaultsCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                     Visibility="{Binding StatusMessage, Converter={x:Static conv:VisibilityConverters.NotNull}}" />
        </StackPanel>
      </Border>

      <!-- Datos y diagnóstico -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Datos y diagnóstico" Style="{StaticResource Text.Section}" />
          <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,16"
                     Text="Los registros solo contienen eventos técnicos: OndaMix nunca guarda audio sin una acción explícita tuya." />

          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Abrir" Command="{Binding OpenConfigFolderCommand}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Configuración" Foreground="{StaticResource Brush.Text}" />
              <TextBlock Text="{Binding ConfigDirectory}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
          </DockPanel>

          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Abrir" Command="{Binding OpenLogFolderCommand}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Registros" Foreground="{StaticResource Brush.Text}" />
              <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
