<UserControl x:Class="OndaMix.Presentation.Views.PlannedPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OndaMix.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlannedPageViewModel}"
             d:DesignWidth="900" d:DesignHeight="600">

  <DockPanel Margin="32,28,32,24">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" />
    </StackPanel>

    <!-- Estado vacío: explica qué habrá aquí y cuándo, sin controles falsos. -->
    <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="40"
            HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="620">
      <StackPanel HorizontalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Brush.AccentSoft}"
                HorizontalAlignment="Center">
          <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="28"
                     Foreground="{StaticResource Brush.AccentHover}" HorizontalAlignment="Center" />
        </Border>

        <TextBlock Text="Todavía no disponible" Style="{StaticResource Text.Section}" FontSize="16"
                   HorizontalAlignment="Center" Margin="0,18,0,0" />

        <Border Style="{StaticResource Badge}" HorizontalAlignment="Center" Margin="0,8,0,0">
          <TextBlock Text="{Binding PhaseLabel}" Style="{StaticResource Badge.Text}" />
        </Border>

        <ItemsControl ItemsSource="{Binding PlannedFeatures}" Margin="0,22,0,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="12"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" Margin="10,0,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DockPanel>
</UserControl>
