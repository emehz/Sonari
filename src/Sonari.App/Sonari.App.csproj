<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ejecutable WPF y raíz de composición: el único proyecto que conoce todas las implementaciones. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(SonariNet)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sonari.App</RootNamespace>
    <AssemblyName>Sonari</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sonari.Audio.Core\Sonari.Audio.Core.csproj" />
    <ProjectReference Include="..\Sonari.Audio.Capture\Sonari.Audio.Capture.csproj" />
    <ProjectReference Include="..\Sonari.Audio.Devices\Sonari.Audio.Devices.csproj" />
    <ProjectReference Include="..\Sonari.Audio.Engine\Sonari.Audio.Engine.csproj" />
    <ProjectReference Include="..\Sonari.Audio.Output\Sonari.Audio.Output.csproj" />
    <ProjectReference Include="..\Sonari.Infrastructure\Sonari.Infrastructure.csproj" />
    <ProjectReference Include="..\Sonari.Presentation\Sonari.Presentation.csproj" />
  </ItemGroup>

</Project>
