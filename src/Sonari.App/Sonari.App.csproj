<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ejecutable WPF y raíz de composición: el único proyecto que conoce todas las implementaciones. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(OndaNet)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OndaMix.App</RootNamespace>
    <AssemblyName>OndaMix</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OndaMix.Audio.Core\OndaMix.Audio.Core.csproj" />
    <ProjectReference Include="..\OndaMix.Audio.Capture\OndaMix.Audio.Capture.csproj" />
    <ProjectReference Include="..\OndaMix.Audio.Devices\OndaMix.Audio.Devices.csproj" />
    <ProjectReference Include="..\OndaMix.Audio.Engine\OndaMix.Audio.Engine.csproj" />
    <ProjectReference Include="..\OndaMix.Audio.Output\OndaMix.Audio.Output.csproj" />
    <ProjectReference Include="..\OndaMix.Infrastructure\OndaMix.Infrastructure.csproj" />
    <ProjectReference Include="..\OndaMix.Presentation\OndaMix.Presentation.csproj" />
  </ItemGroup>

</Project>
